    "@gltf-transform/functions": "^4.5.1",
    "draco3dgltf": "^1.5.9",
    "meshoptimizer": "^1.3.0",
    "puppeteer-core": "^24.43.1",
    "sharp": "^0.35.5",
    "vite": "^8.3.8"
  }
