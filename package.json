{
  "name": "drift-sim",
  "version": "1.4.0",
  "private": true,
  "description": "HTML5 / mobile RWD drift simulator (three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:single": "node tools/build-single.mjs",
    "build:apk": "bash tools/build-apk.sh",
    "preview": "vite preview --host",
    "test": "node --test tests/*.test.js",
